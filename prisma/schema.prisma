generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Standard Shopify App Session storage for authentication and offline tokens.
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model MerchantSettings {
  id        String   @id @default(cuid())
  shop      String   @unique
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Application configuration settings specific to each merchant's shop.
model ShopSettings {
  id              String   @id @default(cuid())
  shop            String   @unique
  minimumExposure Decimal   @default(0)
  lookbackDays    Int       @default(30)
  planType              String    @default("FREE")
  lastManualScanAt      DateTime?
  autoTagOrders         Boolean   @default(false)
  autoResolveExceptions Boolean   @default(false)
  dailySummaryEmails    Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

/// Core domain model: Records detailing identified discrepancies between order refunds and returns.
model ReconciliationException {
  id                  String    @id @default(cuid())
  shop                String
  orderId             String
  orderName           String
  itemName            String?
  lineItemId          String
  variantId           String
  sku                 String?
  refundQuantity      Int
  returnQuantity      Int
  discrepancyQuantity Int
  estimatedExposure   Decimal
  currencyCode        String
  status              String    @default("OPEN")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  resolvedAt          DateTime?
  resolvedBy          String?
  resolutionReason    String?

  @@index([shop])
  @@index([orderId])
  @@index([status])

  @@unique([shop, orderId, lineItemId])
}
